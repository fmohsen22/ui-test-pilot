# ── UI Test Pilot server configuration ─────────────────────────────────
# Copy this file to  server/.env  and fill in what you use.
# run.sh / run.bat load it automatically before starting the server.

# ── Which model backend? ───────────────────────────────────────────────
# openai = ChatGPT API key or ANY OpenAI-compatible gateway (your company model API)
# codex  = the locally installed Codex CLI, signed in with your ChatGPT account
UITP_LLM_PROVIDER=openai

# ── Option A: provider "openai" ────────────────────────────────────────
# Official OpenAI: leave base URL as-is, put your key from platform.openai.com
# Company-internal model with an OpenAI-like API: change the base URL + model.
UITP_LLM_BASE_URL=https://api.openai.com/v1
UITP_LLM_API_KEY=sk-REPLACE_ME
UITP_LLM_MODEL=gpt-4o

# ── Option B: provider "codex" (no API key needed) ─────────────────────
# 1. npm install -g @openai/codex
# 2. codex login        (sign in with your ChatGPT account)
# 3. set UITP_LLM_PROVIDER=codex above — done.
#UITP_CODEX_BIN=codex
#UITP_CODEX_MODEL=
#UITP_CODEX_TIMEOUT=900

# ── Your application under test ────────────────────────────────────────
# The uitests folder of the app you want to test (uitp.config.json + scenarios/)
#UITP_PROJECT_DIR=/path/to/your-app/uitests

# ── Extra admins (first registered user is always admin) ───────────────
#UITP_ADMIN_EMAILS=qa-lead@company.com,cto@company.com

# ── Database (defaults match docker-compose.yml) ───────────────────────
#UITP_DB_URL=jdbc:postgresql://localhost:5544/uitp
#UITP_DB_USER=uitp
#UITP_DB_PASSWORD=uitp
